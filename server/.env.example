# ============================================================
# PRO SPORT — Server Environment Variables (Template / Example)
# ============================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# MONGODB CONNECTION
# ------------------------------------------------------------
# Option 1: MongoDB Atlas (Recommended for production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prosport?retryWrites=true&w=majority

# Option 2: Local MongoDB
# MONGO_URI=mongodb://127.0.0.1:27017/prosport

# ------------------------------------------------------------
# DEFAULT ADMIN CREDENTIALS (seeded automatically on startup)
# ------------------------------------------------------------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@prosport.com
ADMIN_PASSWORD=YourStrongAdminPasswordHere

# ------------------------------------------------------------
# JWT SECRET
# ------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ------------------------------------------------------------
# SERVER & CLIENT CONFIGURATION
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# PAYHERE PAYMENT GATEWAY (SANDBOX)
# ------------------------------------------------------------
PAYHERE_MERCHANT_ID=your_merchant_id_here
PAYHERE_MERCHANT_SECRET=your_merchant_secret_here
PAYHERE_MODE=sandbox
PAYHERE_ACTION_URL=https://sandbox.payhere.lk/pay/checkout

