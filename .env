# Pro Sport Server Environment Variables

# MongoDB connection (optional — server works with mock data if not set)
MONGO_URI=mongodb://127.0.0.1:27017/prosport

# Admin credentials — CHANGE THESE in production!
ADMIN_EMAIL=admin@prosport.lk
ADMIN_PASSWORD=ProSport@2026
ADMIN_NAME=Pro Sport Admin

# JWT secret — use a long random string in production
JWT_SECRET=prosport_admin_jwt_secret_2026_change_in_production

# Server port
PORT=5000
