# ============================================================
# PRO SPORT — Server Environment Variables
# ============================================================

# ------------------------------------------------------------
# MONGODB CONNECTION
# ------------------------------------------------------------
# Option 1: Local MongoDB (default, no Atlas needed)
MONGO_URI=mongodb://127.0.0.1:27017/prosport

# Option 2: MongoDB Atlas (cloud) — replace the line above with:
# MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/prosport?retryWrites=true&w=majority
#
# How to get your Atlas URI:
#   1. Go to https://cloud.mongodb.com
#   2. Click your Cluster → "Connect"
#   3. Choose "Connect your application"
#   4. Copy the connection string
#   5. Replace <USERNAME>, <PASSWORD>, <CLUSTER> with your real values
#   6. Replace <dbname> with: prosport

# ------------------------------------------------------------
# DEFAULT ADMIN CREDENTIALS (seeded automatically on startup)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@prosport.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Pro Sport Admin

# ------------------------------------------------------------
# JWT SECRET — use a long random string in production!
# ------------------------------------------------------------
JWT_SECRET=prosport_jwt_super_secret_change_in_production_2026

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Client origin (used for CORS)
CLIENT_URL=http://localhost:5173
